{
  "@odata.type": "#microsoft.graph.conditionalAccessPolicy",
  "displayName": "CA-006 - External - MFA compatibility",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "signInRiskLevels": [],
    "userRiskLevels": [],
    "servicePrincipalRiskLevels": [],
    "users": {
      "includeUsers": [],
      "excludeUsers": ["%caemergencyusers%"],
      "includeGroups": ["%caexternalcompatibility%"],
      "excludeGroups": [],
      "includeRoles": [],
      "excludeRoles": []
    },
    "applications": {
      "includeApplications": ["All"],
      "excludeApplications": [],
      "includeUserActions": [],
      "includeAuthenticationContextClassReferences": []
    },
    "clientAppTypes": ["all"]
  },
  "grantControls": {
    "operator": "AND",
    "builtInControls": ["mfa"]
  }
}
