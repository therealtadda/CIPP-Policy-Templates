{
  "schemaVersion": 2,
  "kind": "cipp-conditional-access-catalog",
  "catalogId": "cipp-ca-baseline-v1",
  "templateRoot": "CATemplate",
  "sourceTemplateFormat": "raw-cipp-conditional-access-template",
  "sourceContract": {
    "repository": "therealtadda/CIPP-Policy-Templates",
    "revisionType": "git-commit-sha",
    "revisionRequired": true,
    "branchNamesAreDiscoveryHintsOnly": true,
    "digestAlgorithm": "sha256"
  },
  "discovery": {
    "entryPoint": "scripts/Get-CIPPCatalog.ps1",
    "policyPattern": "*.json",
    "ordering": "id-ascending"
  },
  "compatibility": {
    "unknownContractVersion": "reject",
    "minimumCippCapabilities": [
      "raw-conditional-access-template-import",
      "list-variable-expansion",
      "empty-list-removal",
      "device-filters",
      "external-user-targeting",
      "authentication-strength-resolution"
    ]
  },
  "deploymentContract": {
    "repositoryPerformsTenantOperations": false,
    "defaultAction": "discover-and-validate-only",
    "requiresExplicitTenantAuthorization": true,
    "sourceTemplateIsGraphPayload": false,
    "createOrUpdateState": "disabled",
    "activationState": "enabledForReportingButNotEnforced",
    "activationRequiresSeparateExplicitStep": true,
    "requiresReplaceByDisplayName": true,
    "requiresPrecreatedObjects": true,
    "createOrUpdateSteps": [
      "validate-reader-output",
      "resolve-tenant-references",
      "generate-cipp-deployment-input",
      "force-disabled-state",
      "create-or-update"
    ],
    "activationSteps": [
      "verify-created-or-updated-policy-digest-and-scope",
      "verify-disabled-state",
      "check-all-activation-gates",
      "apply-report-only-state-in-separate-operation"
    ],
    "prohibitedActions": [
      "remove-all-exclusions",
      "apply-all-users-as-error-recovery",
      "automatic-group-creation",
      "automatic-policy-enforcement",
      "blind-tenant-wide-deployment"
    ]
  },
  "variables": [
    {
      "token": "%caemergencyusers%",
      "cippType": "List",
      "objectKind": "user",
      "required": true
    },
    {
      "token": "%camfaexceptions%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    },
    {
      "token": "%caprivilegedexceptions%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    },
    {
      "token": "%cawindowsexceptions%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    },
    {
      "token": "%camobileexceptions%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    },
    {
      "token": "%caplatformexceptions%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    },
    {
      "token": "%caprivilegedusers%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    },
    {
      "token": "%caexternalcompatibility%",
      "cippType": "List",
      "objectKind": "group",
      "required": false
    }
  ],
  "policies": [
    {
      "id": "CA-001",
      "path": "CATemplate/CA-001-Baseline-MFA-strength.json",
      "displayName": "CA-001 - Baseline - Require MFA strength",
      "sha256": "0A98A219A598458BF3BBF5574BAB8152F533C8464188ACFC175F572D2F98C485",
      "optional": false,
      "selectionSet": "baseline-core",
      "variables": [
        "%caemergencyusers%",
        "%camfaexceptions%",
        "%caexternalcompatibility%"
      ]
    },
    {
